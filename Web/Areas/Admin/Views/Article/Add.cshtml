@model MakaleEkleDto
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">


            <!-- Bootstrap CSS -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

            <!-- Bootstrap Bundle JS (Popper ile birlikte) -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


            <title>Document</title>
        </head>
    <body>


        <form asp-controller="Article" asp-action="Add" asp-area="Admin" method="post" enctype="multipart/form-data" id="memberForm">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-grid">



                <div class="form-group mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="KategoriId" class="mb-0">
                            <i class="fas fa-tags"></i> Kategoriler
                        </label>

                        <a class="btn btn-sm text-primary" data-bs-toggle="modal" data-bs-target="#exampleModalCenter">
                            Ekle <i class="bx bx-plus"></i>
                        </a>
                    </div>

                    <select required="" asp-for="KategoriId" asp-items="@(new SelectList(Model.Kategories,"Id","Ad"))" class="form-input">
                    </select>
                    <span asp-validation-for="KategoriId" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Baslik">
                        <i class="fas fa-heading"></i>
                        Başlık
                    </label>
                    <input type="text" asp-for="Baslik" class="form-input" wfd-id="id1">

                </div>
                <span asp-validation-for="Baslik" class="text-danger"></span>
                <div class="form-group ">
                    <label asp-for="Ozet">
                        <i class="fas fa-file-alt"></i>
                        Özet
                    </label>
                    <textarea type="text" asp-for="Ozet" style="min-height:300px" class="form-input" wfd-id="id2"></textarea>
                </div>
                <span asp-validation-for="Ozet" class="text-danger"></span>

                <div class="form-group ">
                    <label asp-for="Icerik">
                        <i class="fas fa-file-alt"></i>
                        İçerik
                    </label>
                    <textarea type="text" asp-for="Icerik" style="min-height:300px" class="form-input" wfd-id="id2"></textarea>
                </div>
                <span asp-validation-for="Icerik" class="text-danger"></span>

                <div class="form-group ">
                    <label asp-for="Photo">
                        <i class="fas fa-file-alt"></i>
                        Resim Seçiniz
                    </label>
                    <input type="file" asp-for="Photo" accept="image/*" class="form-control" wfd-id="id2" />

                </div><span asp-validation-for="Photo" class="text-danger"></span>

                <div class="form-group">

                    <label class="form-check-label" asp-for="YorumIzin">
                        Yorumlara izin ver
                    </label>
                    <input class="form-check-input" type="checkbox" asp-for="YorumIzin" checked>
                </div>
                <div class="form-actions">

                    <button type="submit" class="btn  btn-primary">
                        <i class="fas fa-save"></i>
                        Kaydet
                    </button>
                </div>
            </div>

        </form>








        <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLongTitle">Kategori Ekleme</h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form>
                            <div class="form-group">
                                <div class="d-block form-label">
                                    <label asp-for="KategoriId" class="mb-0">
                                        <i class="fas fa-tags"></i> Kategori ismi
                                    </label>
                                    <input class="form-control" id="categoryName" type="text" />

                                </div>


                            </div>

                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                        <button type="button" id="btnSave" data-keyboard="false" class="btn btn-primary">Kaydet</button>
                    </div>
                </div>
            </div>
        </div>


        @section Scripts{
            <script src="~/js/categoryAdd.js"></script>
                <script>
            var app =   app || {};
            app.Urls = app.Urls || {};  
            app.Urls.baseUrl = '@Url.Content("~")';
            app.Urls.categoryAddUrl = "@(Url.Action("AddWithAjax", "Category"))";
            app.Urls.articleAddUrl = "@(Url.Action("Add", "Article"))";
                </script>
        }
    </body>
</html>
