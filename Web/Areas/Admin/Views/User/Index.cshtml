@model List<UserDto>
<div class="page-header">
    <div class="header-title">
        <h2>Kullanıcı Yönetim Sistemi</h2>
        <p>Üyeler</p>
    </div>

    @{@if (!User.IsInRole("User"))
        {
            <div class="header-actions">
                <form asp-area="Admin" asp-controller="User" asp-action="Add" method="get">
                    <button class="add-button">
                        <i class="fas fa-plus"></i>
                        <span>Kullanıcı Ekle</span>
                    </button>
                </form>
            </div>
        }
    }

</div>


<div class="responsive-table-container">
    <table class="table table-responsive" style="margin:0rem;" cellspacing="0">
        <thead>
            <tr>
                <th>İsim</th>
                <th>Soyisim</th>
                <th>Email</th>
                <th>Telefon Numarası</th>
                <th>Rol</th>
                <th>Email Doğrulama</th>
                <th>Bağlantı Hataları</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {

                <tr name="@item.Id">
                    <td>@item.FirstName</td>

                    <td>@item.LastName</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>
                        <span class="badge-role admin">@item.Role</span>
                    </td>
                    <td>@item.EmailConfirmed</td>
                    <td>@item.AccessFailedCount</td>

                    <td data-label="İşlemler">
                        <div class="actions">
                            <a data-id="@item.Id" asp-area="Admin" asp-controller="User" asp-action="Update" asp-route-userId="@item.Id" class="action-btn edit-btn">
                                <i class="fas fa-edit"></i>
                                Düzenle
                            </a>
                            <a data-id="@item.Id" asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-userId="@item.Id" class="action-btn delete-btn">
                                <i class="fas fa-trash"></i>
                                Sil
                            </a>
                        </div>
                    </td>
                </tr>
            }


        </tbody>
    </table>
</div>


