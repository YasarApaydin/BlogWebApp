@model UserDto

<header class="header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-action="Index" asp-controller="Home">
                <div class="brand-icon">
                    <i class="fas fa-pen"></i>
                </div>
                <span class="brand-text">BlogApp</span>
            </a>

            <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" asp-action="Index" asp-controller="Home">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {


                        <li class="nav-item">
                            <a class="nav-link active" asp-action="ProfileDetail" asp-controller="Profile">
                                <i class="fas fa-home"></i>
                                <span>Profile</span>
                            </a>
                        </li>

                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-action="Index" asp-controller="Blog" >
                            <i class="fas fa-blog"></i>
                            <span>Blog</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Create" asp-controller="Blog">
                            <i class="fas fa-blog"></i>
                            <span>Create Article</span>
                        </a>
                    </li>
                  
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/About">
                            <i class="fas fa-info-circle"></i>
                            <span>About</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Contact">
                            <i class="fas fa-envelope"></i>
                            <span>Contact</span>
                        </a>
                    </li>
                </ul>
                <div class="auth-buttons">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="navbar-text me-2 text-white">
                            <i class="fas fa-user"></i> @Model.FirstName @Model.LastName
                        </span>


                           @if (Model.Role == "Admin" || Model.Role == "Superadmin")
        {
            <a class="btn btn-warning me-2" asp-area="Admin" asp-controller="Home" asp-action="Index">
                <i class="fas fa-tools"></i> Admin Panel
            </a>
        }
                        <form method="get" asp-action="Logout" asp-controller="Auth" asp-area="Admin" class="d-inline">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary me-2" asp-action="Login" asp-controller="Auth" asp-area="Admin">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Sign In</span>
                        </a>
                        <a class="btn btn-primary" asp-action="Account" asp-controller="Register">
                            <i class="fas fa-user-plus"></i>
                            <span>Sign Up</span>
                        </a>
                    }
                </div>

            </div>
        </div>
    </nav>
</header>
