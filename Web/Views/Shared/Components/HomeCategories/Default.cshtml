
@model List<BlogWebApp.Entity.DTOs.Kategoris.KategoriDto>


<div class="sidebar-widget">
    <h4 class="widget-title">Categories</h4>
    <ul class="category-list" style="list-style:none;">
        @foreach (var item in Model)
        {
   
            <li><a asp-action="Index" asp-controller="Blog" asp-route-categoryId="@item.Id"><strong><i class="fas fa-code me-2"></i>@item.Ad</strong></a></li>
        }


    </ul>
</div>