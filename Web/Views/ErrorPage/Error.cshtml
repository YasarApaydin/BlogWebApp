@{
    Layout = null;
    int code = ViewBag.StatusCode ?? 0;
}



<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Sayfa Bulunamadı</title>
    <link rel="stylesheet" href="~/css/404.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="stars"></div>
        <div class="stars2"></div>
        <div class="stars3"></div>

        <div class="error-content">
            <div class="error-number">
                <span class="four">@((code / 100) % 10)</span>
                <span class="zero">@((code / 10) % 10)</span>
                <span class="four">@((code % 10))</span>
            </div>

            <div class="error-message">
                <h1>
                    @if (code == 404)
                    {
                    <text>Sayfa Bulunamadı</text>
                    }
                    else if (code == 403)
                    {
                    <text>Erişim Reddedildi</text>
                    }
                    else if (code == 500)
                    {
                    <text>Sunucu Hatası</text>
                    }
                    else
                    {
                    <text>Bir Hata Oluştu</text>
                    }
                </h1>
                <p>
                    @if (code == 404)
                    {
                    <text>Aradığınız sayfa malesef bulunamadı. Belki de başka bir galaksiye seyahat etti!</text>
                    }
                    else if (code == 403)
                    {
                    <text>Bu sayfaya erişim izniniz yok.</text>
                    }
                    else if (code == 500)
                    {
                    <text>Sunucuda beklenmeyen bir hata oluştu.</text>
                    }
                    else
                    {
                    <text>Beklenmeyen bir hata oluştu. Lütfen tekrar deneyin.</text>
                    }
                </p>
            </div>

            <div class="astronaut">
                <div class="astronaut-body">
                    <div class="astronaut-head">
                        <div class="helmet">
                            <div class="helmet-shine"></div>
                        </div>
                        <div class="face">
                            <div class="eyes">
                                <div class="eye left"></div>
                                <div class="eye right"></div>
                            </div>
                            <div class="mouth"></div>
                        </div>
                    </div>
                    <div class="astronaut-torso">
                        <div class="chest-panel">
                            <div class="button red"></div>
                            <div class="button blue"></div>
                            <div class="button green"></div>
                        </div>
                    </div>
                    <div class="astronaut-arms">
                        <div class="arm left"></div>
                        <div class="arm right"></div>
                    </div>
                    <div class="astronaut-legs">
                        <div class="leg left"></div>
                        <div class="leg right"></div>
                    </div>
                </div>
            </div>

            <div class="actions">

                <a asp-controller="Home" asp-action="Index" class="home-btn">
                    <span>Ana Sayfaya Dön</span>
                    <div class="btn-bg"></div>
                </a>

            </div>
        </div>

        <div class="planet planet1"></div>
        <div class="planet planet2"></div>
        <div class="planet planet3"></div>
    </div>

    <script>
   
      

        // Yıldızları hareket ettir
        function createStars() {
            const starsContainer = document.querySelector('.stars');
            for (let i = 0; i < 50; i++) {
                const star = document.createElement('div');
                star.classList.add('star');
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.animationDelay = Math.random() * 2 + 's';
                starsContainer.appendChild(star);
            }
        }

        // Sayfa yüklendiğinde yıldızları oluştur
        window.addEventListener('load', createStars);
    </script>
</body>
</html>


