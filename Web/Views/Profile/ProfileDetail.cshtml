@model UserProfileEditUpdateDto

<main class="main-container">
    <div class="container">
        <div class="profile-header">
            <div class="profile-breadcrumb">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Profil</li>
                    </ol>
                </nav>
            </div>
            <h1>Profil Ayarları</h1>
            <p class="lead">Hesap bilgilerinizi ve tercihlerinizi yönetin</p>
        </div>

        <div class="profile-content">
            <div class="profile-sidebar">
                <div class="profile-nav">
                    <a asp-action="ProfileDetail" asp-controller="Profile" class="profile-nav-item active" data-tab="general">
                        <i class="fas fa-user"></i>
                        <span>Genel Bilgiler</span>
                    </a>
                    <a asp-action="ChangePassword" asp-controller="Profile" class="profile-nav-item" data-tab="security">
                        <i class="fas fa-shield-alt"></i>
                        <span>Güvenlik</span>
                    </a>


                    <a asp-action="ArticleView" asp-controller="Profile" class="profile-nav-item">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Makalelerimi Görüntüle</span>
                    </a>

                    <a asp-action="CommentView" asp-controller="Profile" class="profile-nav-item">
                        <i class="fa-solid fa-comments"></i>
                        <span>Yorumlarımı Görüntüle</span>
                    </a>

                    <a asp-action="ArticleDrafts" asp-controller="Profile" class="profile-nav-item">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Taslakları Görüntüle</span>
                    </a>

                    <a asp-action="CreateCv" asp-controller="Profile" class="profile-nav-item">
                        <i class="fa-solid fa-comments"></i>
                        <span>Cv Oluştur</span>
                    </a>

                </div>
            </div>

            <div class="profile-main">
                <!-- General Tab -->
                <div class="profile-tab active" id="general">
                    <div class="profile-card">
                        <div class="profile-card-header">
                            <h3>Profil Bilgileri</h3>
                            <p>Temel hesap bilgilerinizi güncelleyin</p>
                        </div>
                        <form method="post" enctype="multipart/form-data" asp-action="ProfileDetail" asp-controller="Profile" class="profile-form">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <div class="profile-card-body">
                                <div class="profile-avatar-section">
                                    <div class="profile-avatar">
                                        <img src="@(Model.Resim?.DosyaYolu ?? "default-avatar.png")" alt="Profil Fotoğrafı" id="profileImage">
                                        <div class="avatar-overlay">
                                            <i class="fas fa-camera"></i>
                                        </div>
                                    </div>
                                    <div class="avatar-info">
                                        <h4>Profil Fotoğrafı</h4>
                                        <p>JPG, PNG veya GIF formatında, maksimum 5MB</p>
                                        <div class="avatar-buttons">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('avatarInput').click()">
                                                <i class="fas fa-upload"></i>
                                                Fotoğraf Değiştir
                                            </button>
                                        </div>
                                        <input type="file" id="avatarInput" asp-for="Photo" accept="image/*" style="display: none;">
                                    </div>
                                </div>


                                <div class="form-row">
                                    <div class="form-group">
                                        <label asp-for="FirstName" class="form-label"></label>
                                        <input type="text" asp-for="FirstName" class="form-control" id="firstName" required>
                                        <span asp-validation-for="FirstName"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="LastName" class="form-label"></label>
                                        <input type="text" class="form-control" id="lastName" asp-for="LastName" required>
                                        <span asp-validation-for="LastName"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input type="email" class="form-control" id="email" asp-for="Email" required>
                                    <span asp-validation-for="Email"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="PhoneNumber" class="form-label"></label>

                                    <input type="tel" class="form-control" id="phone" asp-for="PhoneNumber">
                                    <span asp-validation-for="PhoneNumber"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Role" class="form-label"></label>
                                    <input type="text" class="form-control" disabled asp-for="Role">
                                </div>




                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i>
                                        Değişiklikleri Kaydet
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary">
                                        <i class="fas fa-undo"></i>
                                        İptal
                                    </button>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>

                <!-- Security Tab -->
                <div class="profile-tab" id="security">
                    <div class="profile-card">
                        <div class="profile-card-header">
                            <h3>Güvenlik Ayarları</h3>
                            <p>Hesabınızın güvenliğini artırın</p>
                        </div>
                        <div class="profile-card-body">
                            <div class="security-item">
                                <div class="security-info">
                                    <h4>Şifre</h4>
                                    <p>Son değiştirilme: 15 gün önce</p>
                                </div>
                                <a class="btn btn-outline-primary" asp-action="ChangePassword" asp-controller="Profile">
                                    <i class="fas fa-key"></i>
                                    Şifre Değiştir
                                </a>
                            </div>
                            <div class="security-item">
                                <div class="security-info">
                                    <h4>İki Faktörlü Doğrulama</h4>
                                    <p>Hesabınız için ek güvenlik katmanı</p>
                                </div>
                                <div class="security-toggle">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="twoFactor">
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span class="toggle-status">Kapalı</span>
                                </div>
                            </div>
                            <div class="security-item">
                                <div class="security-info">
                                    <h4>Oturum Geçmişi</h4>
                                    <p>Son giriş yapılan cihazları görüntüleyin</p>
                                </div>
                                <button class="btn btn-outline-secondary">
                                    <i class="fas fa-history"></i>
                                    Geçmişi Görüntüle
                                </button>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
        </div>
    </div>
</main>




<script src="~/js/profile.js"></script>