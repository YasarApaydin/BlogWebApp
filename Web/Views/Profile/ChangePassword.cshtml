@model UserNewPasswordDto   

 <!-- Main Content -->
<main class="main-container">
    <div class="container">
        <div class="password-change-wrapper">
            <div class="password-change-header">
                <div class="back-button">
                    <a asp-action="ProfileDetail" asp-controller="Profile" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i>
                        Geri Dön
                    </a>
                </div>
                <div class="page-title">
                    <h1>Şifre Değiştir</h1>
                    <p class="lead">Hesabınızın güvenliği için güçlü bir şifre seçin</p>
                </div>
            </div>

            <div class="password-change-content">
                <div class="password-change-card">
                    <div class="security-tips">
                        <h3>
                            <i class="fas fa-shield-alt"></i>
                            Güvenlik İpuçları
                        </h3>
                        <ul class="tips-list">
                            <li>
                                <i class="fas fa-check"></i>
                                En az 8 karakter uzunluğunda olmalı
                            </li>
                            <li>
                                <i class="fas fa-check"></i>
                                Büyük ve küçük harf içermeli
                            </li>
                            <li>
                                <i class="fas fa-check"></i>
                                En az bir rakam içermeli
                            </li>
                            <li>
                                <i class="fas fa-check"></i>
                                Özel karakter içermeli (!#$%^&*)
                            </li>
                        </ul>
                    </div>

                    <form asp-action="ChangePassword" asp-controller="Profile" method="post" class="password-change-form" id="passwordChangeForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="MevcutSifre" class="form-label">Mevcut Şifre</label>
                            <div class="password-input-group">
                                <input asp-for="MevcutSifre" type="password" class="form-control" id="currentPassword" required>
                                <button type="button" class="password-toggle" onclick="togglePassword('currentPassword')">
                                    <i class="fas fa-eye" id="currentPasswordIcon"></i>
                                </button>

                            </div>
                            <span class="text-danger" asp-validation-for="MevcutSifre"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="YeniSifre" class="form-label">Yeni Şifre</label>
                            <div class="password-input-group">
                                <input asp-for="YeniSifre" type="password" class="form-control" id="newPassword" required>
                                <button type="button" class="password-toggle" onclick="togglePassword('newPassword')">
                                    <i class="fas fa-eye" id="newPasswordIcon"></i>
                                </button>
                            </div>
                            <div class="password-strength" id="passwordStrength">
                                <div class="strength-bar">
                                    <div class="strength-fill" id="strengthFill"></div>
                                </div>
                                <span class="strength-text" id="strengthText">Şifre gücü</span>
                            </div>
                            <span class="text-danger" asp-validation-for="YeniSifre"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="YeniSifreTekrar" class="form-label">Yeni Şifre (Tekrar)</label>
                            <div class="password-input-group">
                                <input asp-for="YeniSifreTekrar" type="password" class="form-control" id="confirmPassword" required>
                                <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                                    <i class="fas fa-eye" id="confirmPasswordIcon"></i>
                                </button>
                            </div>
                            <div class="password-match" id="passwordMatch"></div>
                        </div>
                        <span class="text-danger" asp-validation-for="YeniSifreTekrar"></span>
                        <div class="password-requirements" id="passwordRequirements">
                            <h4>Şifre Gereksinimleri</h4>
                            <div class="requirement-list">
                                <div class="requirement-item" id="lengthReq">
                                    <i class="fas fa-times"></i>
                                    <span>En az 8 karakter</span>
                                </div>
                                <div class="requirement-item" id="uppercaseReq">
                                    <i class="fas fa-times"></i>
                                    <span>Büyük harf (A-Z)</span>
                                </div>
                                <div class="requirement-item" id="lowercaseReq">
                                    <i class="fas fa-times"></i>
                                    <span>Küçük harf (a-z)</span>
                                </div>
                                <div class="requirement-item" id="numberReq">
                                    <i class="fas fa-times"></i>
                                    <span>Rakam (0-9)</span>
                                </div>
                                <div class="requirement-item" id="specialReq">
                                    <i class="fas fa-times"></i>
                                    <span>Özel karakter (!#$%^&*)</span>
                                </div>
                            </div>
                        </div>
                        <a href="@Url.Action("ForgotPassword", "Account")" class="btn btn-link ml-3" style="white-space: nowrap;">
                            Mevcut şifrenizi mi unuttunuz?
                        </a>
                        <div class="form-actions">
                            <button id="submitBtn" type="submit" class="btn btn-primary">
                                <i class="fas fa-key"></i>
                                Şifreyi Değiştir
                            </button>
                            <button type="button" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i>
                                İptal
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</main>
<script src="~/js/change-password.js"></script>