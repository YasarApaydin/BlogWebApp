@model UserRegisterDto
@{ 
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/Account.css">
    
   
</head>
<body>
    <a asp-action="Index" asp-controller="Home" class="back-button" aria-label="Ana Sayfaya Dön">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo">
                    <i class="fas fa-user-plus"></i>
                    <h1 class="animated-text">Hesap Oluştur</h1>
                </div>
                <p class="animated-text">Yeni bir hesap oluşturmak için bilgilerinizi girin.</p>
            </div>

            <form asp-controller="Register" asp-action="Account" method="post" class="login-form" id="signupForm">

                <div asp-validation-summary="All" style="color:red;"></div>
                <div class="form-group">
                    <label asp-for="FirstName">
                        <i class="fas fa-user"></i>
                        <span class="animated-text">Ad</span>
                    </label>
                    <input type="text"
                           asp-for="FirstName"
                           placeholder="Ad"
                           required
                           autocomplete="name"
                           title="Lütfen adınızı girin">
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">
                        <i class="fas fa-user"></i>
                        <span class="animated-text">Soyad</span>
                    </label>
                    <input type="text"
                           asp-for="LastName"
                           placeholder="Soyad"
                           required
                           autocomplete="surname"
                           title="Lütfen soyadınızı girin">
                    <span asp-validation-for="LastName" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber">
                        <i class="fas fa-phone"></i>
                        <span class="animated-text">Telefon Numarası</span>
                    </label>
                    <input type="tel"
                           asp-for="PhoneNumber"
                           placeholder="Telefon Numaranızı Giriniz."
                           required
                           autocomplete="surname"
                           title="Lütfen Telefon Numaranızı Giriniz.">
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>


                <div class="form-group">
                    <label asp-for="Email">
                        <i class="fas fa-envelope"></i>
                        <span class="animated-text">E-posta Adresi</span>
                    </label>
                    <input type="email"
                           asp-for="Email"
                           placeholder="ornek@sirket.com"
                           required
                           autocomplete="email"
                           title="Lütfen geçerli bir e-posta adresi girin">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">
                        <i class="fas fa-lock"></i>
                        <span class="animated-text">Şifre</span>
                    </label>
                    <div class="password-input">
                        <input type="password"
                               asp-for="Password"  
                               placeholder="••••••••"
                               required
                               autocomplete="new-password"
                               title="Şifre en az 8 karakter uzunluğunda olmalı ve en az 1 büyük harf, 1 küçük harf, 1 sayı ve 1 özel karakter içermelidir">
                        <button type="button"
                                class="toggle-password"
                                onclick="togglePassword('Password')"
                                aria-label="Şifreyi göster/gizle">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-requirements" id="passwordRequirements">
                        <p>Şifre gereksinimleri:</p>
                        <ul>
                            <li id="length">✗ En az 8 karakter</li>
                            <li id="uppercase">✗ En az 1 büyük harf</li>
                            <li id="lowercase">✗ En az 1 küçük harf</li>
                            <li id="number">✗ En az 1 sayı</li>
                            <li id="special">✗ En az 1 özel karakter</li>
                        </ul>
                    </div>
                    <div class="password-strength">
                        <div class="strength-meter">
                            <div class="strength-meter-fill" id="strengthMeter"></div>
                        </div>
                        <span class="strength-text" id="strengthText">Şifre Gücü: Girilmedi</span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>




                <div class="form-group">
                    <label asp-for="ConfirmPassword">
                        <i class="fas fa-lock"></i>
                        <span class="animated-text">Şifre Tekrar</span>
                    </label>
                    <div class="password-input">
                        <input type="password"
                               asp-for="ConfirmPassword"
                               placeholder="••••••••"
                               required
                               autocomplete="new-password"
                               title="Lütfen şifrenizi tekrar girin">
                        <button type="button"
                                class="toggle-password"
                                onclick="togglePassword('ConfirmPassword')"
                                aria-label="Şifreyi göster/gizle">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-match" id="passwordMatch"></div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-options">
                    <label class="remember-me animated-text">
                        <input type="checkbox" name="TermsAccepted" required>
                        <span>Kullanım şartlarını kabul ediyorum</span>
                    </label>
                </div>

                <button type="submit" class="login-button">
                    <div class="button-loader"></div>
                    <i class="fas fa-user-plus"></i>
                    <span>Hesap Oluştur</span>
                </button>
            </form>

            <div class="login-footer">
                <p class="animated-text">Zaten hesabınız var mı?</p>
                <a asp-action="Login" asp-controller="Auth" asp-area="Admin" class="register-link animated-text">Giriş Yap</a>
            </div>

            <div class="security-info animated-text">
                <i class="fas fa-lock"></i>
                <p>Bu bağlantı güvenli ve şifrelidir</p>
            </div>
        </div>
    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="~/js/Account.js"></script>



    @await Component.InvokeAsync("NToastNotify")

</body>
</html>