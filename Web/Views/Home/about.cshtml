@{
    ViewData["Title"] = "Hakkımda";
}

<!-- Sayfa Başlığı -->
<div class="page-header">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="page-header-content">
                    <h1>Hakkımda</h1>
                    <p class="lead">Yazılım geliştirme tutkusu ile yolculuğum</p>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Anasayfa</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Hakkımda</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hakkımda Bölümü -->
<section class="section">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6">
                <div class="about-content">
                    <h2>Merhaba, ben Yaşar Apaydın</h2>
                    <p class="lead">.NET teknolojileri ile yazılım çözümleri üreten bir geliştiriciyim.</p>
                    <p>Bu blog, hem kendi öğrendiklerimi paylaşmak hem de yazılım dünyasında karşılaştığım problemleri, çözümleri ve deneyimleri aktarmak için oluşturuldu.</p>
                    <p>Yazılım geliştirme, sürekli öğrenmeyi gerektiren bir yolculuk. Bu yolculukta edindiğim bilgi ve tecrübeleri burada sizlerle paylaşıyorum.</p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-image text-center">
                    <img src="~/images/User/aboutImage.png" alt="About" class="img-fluid rounded-lg" style="max-width: 320px;">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vizyon/Misyon -->
<section class="section bg-light">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2>Vizyon & Misyon</h2>
            <p class="text-muted">Yazılım geliştirirken benimsediğim temel değerler</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-lightbulb mb-3 fa-2x text-primary"></i>
                        <h5>Yenilikçilik</h5>
                        <p>Yeni teknolojileri takip ederek sürekli gelişen yazılım dünyasına ayak uydurmak.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-code mb-3 fa-2x text-primary"></i>
                        <h5>Temiz Kod</h5>
                        <p>Bakımı kolay, okunabilir ve sürdürülebilir yazılım geliştirmek en önemli önceliklerimdendir.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-users mb-3 fa-2x text-primary"></i>
                        <h5>Paylaşım</h5>
                        <p>Topluluğa katkı sunmak, bildiklerimi başkalarına aktarmak için bu platformu kurdum.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Takım (Sadece Sen) -->
<section class="section">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2>Ben Kimim?</h2>
            <p class="text-muted">Blogun yazarı</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="card team-card">
                    <div class="card-body text-center">
                        <img src="~/images/User/Ben.png" alt="Yaşar Apaydın" class="team-avatar mb-3" style="border-radius: 12px; width: 200px;">
                        <h5 class="card-title">Yaşar Apaydın</h5>
                        <p class="team-role">.NET Geliştirici</p>
                        <p class="card-text">
                            C# ve ASP.NET Core teknolojileriyle güçlü, ölçeklenebilir web uygulamaları geliştiriyorum.<br />
                            Kod kalitesine, temiz mimariye ve sürekli öğrenmeye büyük önem veririm.
                        </p>
                        <div class="social-icons">
                            <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-github"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
