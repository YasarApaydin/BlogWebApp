<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 animate-on-scroll">
                <div class="hero-content">
                    <h1>Yaz, Paylaş, Yorumla ve CV Oluştur</h1>
                    <p class="lead">BlogCraft ile yazılarını yayınla, yorum al, fikirlerini paylaş ve kişisel CV’ni oluştur. Yazmanın yeni nesil hali burada başlıyor!</p>
                    <div class="hero-buttons">
                        <a asp-action="Account" asp-controller="Register" class="btn btn-primary btn-lg">
                            <i class="fas fa-pen-nib me-2"></i>Hemen Kayıt Ol
                        </a>
                        <a href="#features" class="btn btn-outline-primary btn-lg ms-2">
                            <i class="fas fa-book-reader me-2"></i>Nasıl Çalışır?
                        </a>
                    </div>

                    <div class="hero-stats">
                        <div class="stat-item">
                            <div id="totalArticleCount" class="stat-number"></div>
                            <div class="stat-label">Yayınlanan Yazı</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number" id="totalCommentsCount"></div>
                            <div class="stat-label">Yorum</div>
                        </div>
                        <div class="stat-item">
                            <div id="totalUsersCount" class="stat-number"></div>
                            <div class="stat-label">Atif Kullanıcı</div>
                        </div>
                    </div>
             
                
                </div>
            </div>
            <div class="col-lg-6 animate-on-scroll">
                <div class="hero-image">
                    <img src="https://images.pexels.com/photos/3184465/pexels-photo-3184465.jpeg" alt="Blog Writing" class="img-fluid rounded-lg">
                </div>
            </div>
        </div>
    </div>


</section>

<!-- Features Section -->
<section class="section bg-light" id="features">
    <div class="container">
        <div class="section-header animate-on-scroll">
            <h2>BlogCraft Ne Sunuyor?</h2>
            <p class="lead">Yazarlık deneyimini zenginleştiren eşsiz özellikler</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-feather-alt fa-3x text-primary"></i>
                        </div>
                        <h4 class="card-title">Blog Yaz & Paylaş</h4>
                        <p class="card-text">Kendine ait bir alan oluştur, içeriklerini kolayca yaz ve okuyucularınla paylaş.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-comments fa-3x text-primary"></i>
                        </div>
                        <h4 class="card-title">Yorumlarla Etkileşim</h4>
                        <p class="card-text">Okuyucuların fikirlerini paylaşabilir, yazılarına yorumlar bırakabilir.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-id-card-alt fa-3x text-primary"></i>
                        </div>
                        <h4 class="card-title">CV Oluştur</h4>
                        <p class="card-text">Profilin üzerinden kolayca şık ve etkileyici bir özgeçmiş oluştur.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-heart fa-3x text-primary"></i>
                        </div>
                        <h4 class="card-title">Favorilere Ekle</h4>
                        <p class="card-text">Beğendiğin yazıları kaydet, sonra tekrar kolayca oku ve paylaş.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-lightbulb fa-3x text-primary"></i>
                        </div>
                        <h4 class="card-title">Yazarlık Tavsiyeleri</h4>
                        <p class="card-text">Yazarken ilham alabileceğin öneriler ve rehber yazılarla destek al.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-globe fa-3x text-primary"></i>
                        </div>
                        <h4 class="card-title">Topluluk Desteği</h4>
                        <p class="card-text">Farklı yazarlardan oluşan topluluğa katıl, içeriklerini büyüt.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
        var app = app || {}
        app.Urls = app.Urls || {}


    app.Urls.totalArticleCountUrl = "@(Url.Action("TotalArticleCount", "Home"))";

    app.Urls.totalUsersCountUrl = "@(Url.Action("TotalUsersCount", "Home"))";

    app.Urls.totalCommentsCountUrl = "@(Url.Action("TotalCommentsCount", "Home"))";



</script>

<script src="~/js/HomeIndex.js"></script>